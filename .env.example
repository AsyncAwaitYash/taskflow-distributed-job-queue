# Copy to .env when you run TaskFlow locally. Never commit .env.
# Replace every placeholder before use. These are not real secrets.

# SQL Server. The API and the worker read ConnectionStrings__TaskFlow. Nothing starts SQL Server for you.
# MSSQL_SA_PASSWORD=replace-with-a-local-only-password
# ConnectionStrings__TaskFlow=Server=localhost,1433;Database=TaskFlow;User Id=sa;Password=replace-with-a-local-only-password;TrustServerCertificate=True

# RabbitMQ. The API and the worker read ConnectionStrings__RabbitMq as an amqp:// URI. Without it, POST /api/v1/jobs returns 503.
# Nothing starts RabbitMQ for you.
# RABBITMQ_DEFAULT_USER=taskflow
# RABBITMQ_DEFAULT_PASS=replace-with-a-local-only-password
# ConnectionStrings__RabbitMq=amqp://taskflow:replace-with-a-local-only-password@localhost:5672/
# TaskFlow__RabbitMq__PublishTimeout=00:00:05

# Worker. It needs both connection strings above and refuses to start without them.
# TaskFlow__Worker__PrefetchCount=1
# TaskFlow__Worker__WorkerId=worker-1
# TaskFlow__Worker__DatabaseRetryDelay=00:00:05

# Retry backoff. Defaults are 5s, then 25s, then 125s, then 10 minutes, each jittered by 20 percent.
# TaskFlow__Retry__BaseDelay=00:00:05
# TaskFlow__Retry__Multiplier=5
# TaskFlow__Retry__MaxDelay=00:10:00
# TaskFlow__Retry__JitterRatio=0.2
